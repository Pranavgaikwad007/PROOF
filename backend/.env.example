# PROOF Backend Configuration

# Server
PORT=4000
NODE_ENV=development

# CORS - Allowed frontend origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Database
# Default: SQLite file database for zero-friction demo resilience
DATABASE_URL="file:./dev.db"
# PostgreSQL Alternative:
# DATABASE_URL="postgresql://proof_user:proof_pass@localhost:5432/proof_db?schema=public"

# Authentication
JWT_SECRET="proof_development_jwt_secret_key_change_in_production_32chars"
JWT_EXPIRES_IN="7d"

# AI Coach Configuration (OpenAI-compatible API)
# Leave OPENAI_API_KEY blank to use the built-in, highly realistic MOCK COACH
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Candidate Runner Sandbox Config
# Note: Runner runs safely as a sandboxed stub process. Do NOT run untrusted code on the API host.
RUNNER_TIMEOUT_MS=5000
